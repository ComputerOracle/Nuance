# Copy to .env for local development. Every setting here is declared in
# app/config.py — see that file for full docstrings on each; this file
# tracks it (config.py's own stated intent, previously undelivered).

# --- Core ---
# Local dev default. For a real Postgres (see ../docker-compose.yml):
#   DATABASE_URL=postgresql+asyncpg://nuance:nuance@localhost:5432/nuance
# Postgres requires `alembic upgrade head` run first — see backend/alembic/
# and ROADMAP.md Part 3 5.1. Sqlite auto-creates/patches its own schema on
# startup (app/db.py::init_db) and needs no migration step.
DATABASE_URL=sqlite+aiosqlite:///./nuance.db
CORS_ORIGINS=http://localhost:3000

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=1440

# --- AI validator providers (consensus engine) ---
# All three optional — missing/exhausted providers fall back to the next
# (Gemini -> Anthropic -> OpenAI -> deterministic offline heuristic), see
# services/consensus.py. Real AI judgment needs at least one working key;
# with none, every verdict is the labeled offline stand-in.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- GenLayer market-generator ingestion (optional) ---
TWITTERAPI_IO_KEY=
TWITTER_BEARER_TOKEN=
MARKET_GENERATOR_ACCOUNTS=genlayer
MARKET_GENERATOR_RSS_FEEDS=
MARKET_GENERATOR_WEB_PAGES=

# --- Idempotency / rate limiting ---
IDEMPOTENCY_TTL_HOURS=24
WRITE_RATE_LIMIT_PER_MINUTE=10

# --- GenLayer Bradbury testnet (see ROADMAP.md Part 2 / scripts/deploy.ts) ---
GENLAYER_PRIVATE_KEY=
DISPUTE_COURT_CONTRACT_ADDRESS=
ESCROW_CONTRACT_ADDRESS=
PREDICTION_MARKET_CONTRACT_ADDRESS=
GOVERNANCE_CONTRACT_ADDRESS=
VALIDATORS_CONTRACT_ADDRESS=
AGENT_DIRECTORY_CONTRACT_ADDRESS=
GENLAYER_INDEXER_POLL_SECONDS=15
ENABLE_CHAIN_INDEXER=true
DISPUTE_ID_SCAN_WINDOW=50

# --- Part 3 hardening: Postgres/Redis/security ---
# Optional — unreachable Redis degrades the consensus WS channel to plain
# DB polling, same as every other "no key configured" fallback here.
REDIS_URL=redis://localhost:6379/0
# Sybil-resistant governance vote weight — see app/config.py's own
# docstring on these two and routers/governance.py::_voting_power.
SYBIL_VOTE_WEIGHT_MAX=5
SYBIL_VOTE_WEIGHT_PERIOD_DAYS=7
