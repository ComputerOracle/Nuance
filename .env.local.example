# Copy to .env.local for local development.

# Base URL of the Nuance FastAPI backend (see ../backend). Defaults to
# http://localhost:8010 in lib/api.ts if unset — make sure the backend is
# actually running on that port (e.g. `uvicorn app.main:app --port 8010`),
# or set this to match wherever you run it.
NEXT_PUBLIC_API_URL=http://localhost:8010

# GenLayer Bradbury testnet contract addresses (see ROADMAP.md Part 2 /
# 4.4/4.6). All six are live as of 2026-09-06 — see ROADMAP.md 4.4's
# table for the actual addresses; left blank here since this file is the
# checked-in template, not a real environment. lib/chain-config.ts
# currently only reads the first three (escrow/disputeCourt/
# predictionMarket) — Governance/Validators/AgentDirectory don't have
# frontend signing wiring yet, but scripts/deploy.ts already writes their
# NEXT_PUBLIC_* vars too, so they're listed here for completeness. A
# missing address is "route through the legacy off-chain path," not an
# error — leaving these blank is the correct/expected state pre-cutover.
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=
NEXT_PUBLIC_DISPUTE_COURT_CONTRACT_ADDRESS=
NEXT_PUBLIC_PREDICTION_MARKET_CONTRACT_ADDRESS=
NEXT_PUBLIC_GOVERNANCE_CONTRACT_ADDRESS=
NEXT_PUBLIC_VALIDATORS_CONTRACT_ADDRESS=
NEXT_PUBLIC_AGENT_DIRECTORY_CONTRACT_ADDRESS=
