# Copy to .env.local for local development.

# Base URL of the Nuance FastAPI backend (see ../backend). Defaults to
# http://localhost:8010 in lib/api.ts if unset — make sure the backend is
# actually running on that port (e.g. `uvicorn app.main:app --port 8010`),
# or set this to match wherever you run it.
NEXT_PUBLIC_API_URL=http://localhost:8010

# GenLayer Bradbury testnet contract addresses (see ROADMAP.md Part 2 /
# 4.6). Unset until Chibuikem's deploy script actually publishes these —
# lib/chain-config.ts treats a missing address as "route through the
# legacy off-chain consensus path," not an error, so leaving these blank
# is the correct/expected state pre-cutover. Fill in once deploy.py
# reports real addresses (SYNC POINT).
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=
NEXT_PUBLIC_DISPUTE_COURT_CONTRACT_ADDRESS=
NEXT_PUBLIC_PREDICTION_MARKET_CONTRACT_ADDRESS=
