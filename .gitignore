# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright E2E (playwright.config.ts, e2e/) — HTML/trace/screenshot
# artifacts from a local or CI run, not source.
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
!backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python (contracts/ has no venv of its own, but syntax-checking it locally
# still leaves __pycache__ behind)
__pycache__/
*.pyc

# sdk/ (ROADMAP.md Part 4 6.3) — src/generated/ and nuance_client/ ARE
# checked in (see sdk/README.md: consumers shouldn't need a codegen step),
# but node_modules and compiled TS output are ordinary build artifacts,
# same as the frontend's own /node_modules and /.next above.
sdk/typescript/node_modules/
sdk/typescript/dist/
